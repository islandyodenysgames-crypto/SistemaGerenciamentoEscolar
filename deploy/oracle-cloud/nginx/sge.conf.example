# Substitua escola.exemplo.br e confirme o socket do PHP antes de habilitar.
server {
    listen 80;
    listen [::]:80;
    server_name escola.exemplo.br;
    location ^~ /.well-known/acme-challenge/ { root /var/www/letsencrypt; }
    location / { return 301 https://$host$request_uri; }
}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name escola.exemplo.br;

    root /var/www/sge/current/public;
    index index.php;
    server_tokens off;

    ssl_certificate /etc/letsencrypt/live/escola.exemplo.br/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/escola.exemplo.br/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_cache shared:SSL:10m;

    client_max_body_size 512m;
    client_body_timeout 300s;
    send_timeout 300s;

    add_header X-Content-Type-Options nosniff always;
    add_header X-Frame-Options SAMEORIGIN always;
    add_header Referrer-Policy strict-origin-when-cross-origin always;
    add_header Permissions-Policy "camera=(), microphone=(), geolocation=()" always;
    # Ative HSTS somente depois de validar domínio, subdomínios e HTTPS.
    # add_header Strict-Transport-Security "max-age=31536000" always;
    # Primeiro valide em Report-Only; a interface atual ainda contém scripts/estilos inline.
    add_header Content-Security-Policy-Report-Only "default-src 'self'; img-src 'self' data: blob:; media-src 'self' blob:; font-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'; frame-src 'self' https://www.youtube.com https://www.youtube-nocookie.com; object-src 'none'; base-uri 'self'; frame-ancestors 'self'; form-action 'self'" always;

    location / {
        limit_except GET POST { deny all; }
        try_files $uri $uri/ /index.php?$query_string;
    }

    # Os arquivos privados são entregues exclusivamente por /arquivos/visualizar.
    location ~ ^/uploads/(students|users|occurrences|occurrence-actions|monitoring-actions)/ { return 404; }
    location ~ ^/uploads/notices/[0-9]{4}/[0-9]{2}/[0-9]+/attachments/ { return 404; }
    location ~* ^/uploads/.*\.(php|phtml|phar|cgi|pl|py|sh|asp|aspx|jsp|svg)$ { return 404; }

    location ~* ^/assets/.*\.(?:css|js|png|jpe?g|webp|gif|ico|woff2?)$ {
        expires 7d;
        add_header Cache-Control "public, max-age=604800";
        try_files $uri =404;
    }
    location ~* ^/uploads/.*\.(?:png|jpe?g|webp|gif)$ {
        expires 1d;
        add_header Cache-Control "public, max-age=86400";
        try_files $uri =404;
    }

    location = /index.php {
        include fastcgi_params;
        fastcgi_param SCRIPT_FILENAME $document_root/index.php;
        fastcgi_param HTTP_PROXY "";
        fastcgi_pass unix:/run/php/php8.3-fpm.sock;
        fastcgi_connect_timeout 30s;
        fastcgi_send_timeout 300s;
        fastcgi_read_timeout 300s;
    }
    location ~ \.php$ { return 404; }
    location ~ /\. { deny all; }

    access_log /var/log/nginx/sge-access.log;
    error_log /var/log/nginx/sge-error.log warn;
}
