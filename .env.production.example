APP_NAME="Sistema de Gerenciamento Escolar"
APP_ENV=production
APP_DEBUG=false
APP_URL=https://escola.exemplo.br
APP_TIMEZONE=America/Fortaleza

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=sge_production
DB_USERNAME=sge_app
DB_PASSWORD=SUBSTITUA_POR_SEGREDO_FORTE_FORA_DO_GIT

SESSION_NAME=sge_session
SESSION_LIFETIME=1800
SESSION_REGENERATE_INTERVAL=900
SESSION_REVALIDATE_INTERVAL=0
SESSION_SAME_SITE=Lax

# Vazio quando o Nginx atende diretamente a internet. Informe somente IPs/CIDRs de proxies controlados.
TRUSTED_PROXIES=
LOGIN_IDENTITY_LIMIT=5
LOGIN_ORIGIN_LIMIT=50
LOGIN_WINDOW=900
LOGIN_LOCKOUT=900

# Use ao criar a primeira conta; remova estas três linhas após o provisionamento.
INITIAL_ADMIN_NAME=Administrador
INITIAL_ADMIN_EMAIL=
INITIAL_ADMIN_PASSWORD=

# Gere, por exemplo, com: openssl rand -hex 32
TV_PANEL_ACCESS_TOKEN=SUBSTITUA_POR_TOKEN_ALEATORIO_DE_64_HEXADECIMAIS
TV_PANEL_COOKIE_NAME=sge_tv_device

# Diretórios operacionais fixos nesta versão:
# storage/logs, storage/backups e public/uploads. Não coloque backups externos dentro do document root.
