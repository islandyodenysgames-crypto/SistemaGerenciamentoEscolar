APP_NAME="Sistema de Frequência Escolar"

APP_ENV=local

APP_DEBUG=true

APP_URL=http://localhost/SistemaFrequenciaEscolar/public

APP_TIMEZONE=America/Fortaleza

DB_CONNECTION=mysql

DB_HOST=127.0.0.1

DB_PORT=3306

DB_DATABASE=frequencia_escolar

DB_USERNAME=root

DB_PASSWORD=

# Produção: use HTTPS e a URL pública exata, inclusive eventual subdiretório.
SESSION_NAME=sge_session
SESSION_LIFETIME=1800
SESSION_REGENERATE_INTERVAL=900
SESSION_REVALIDATE_INTERVAL=300
SESSION_SAME_SITE=Lax
# Somente proxies controlados pela escola/plataforma podem fornecer X-Forwarded-*.
TRUSTED_PROXIES=
LOGIN_IDENTITY_LIMIT=5
LOGIN_ORIGIN_LIMIT=50
LOGIN_WINDOW=900
LOGIN_LOCKOUT=900

# Usadas apenas ao criar o primeiro administrador. Nunca são impressas em logs.
INITIAL_ADMIN_NAME=Administrador
INITIAL_ADMIN_EMAIL=
INITIAL_ADMIN_PASSWORD=
